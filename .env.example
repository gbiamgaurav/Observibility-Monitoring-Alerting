# ── Groq API (get free key at https://console.groq.com) ───────
GROQ_API_KEY=gsk_your_key_here

# ══════════════════════════════════════════════════════════════
# CLOUD PROVIDER — uncomment the block for the provider you use.
# SQL files live in: bigquery/ (GCP), athena/ (AWS), azure/ (Azure)
# ══════════════════════════════════════════════════════════════

# ── Google Cloud (BigQuery + GCS) ─────────────────────────────
# Service account JSON key → GCP Console > IAM > Service Accounts > Keys
# Required roles: BigQuery Data Editor, BigQuery Job User, Storage Object Viewer
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-service-account-key.json
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCS_LOG_BUCKET=gs://your-bucket/pipeline-logs/
BIGQUERY_DATASET=pipeline_observability
BIGQUERY_LOCATION=US

# ── AWS (Athena + S3) ─────────────────────────────────────────
# IAM user/role needs: AthenaFullAccess, S3 read on log bucket, S3 write on results bucket
#AWS_ACCESS_KEY_ID=your_key
#AWS_SECRET_ACCESS_KEY=your_secret
#AWS_REGION=us-east-1
#ATHENA_S3_OUTPUT=s3://your-bucket/athena-results/
#PIPELINE_LOGS_S3=s3://your-bucket/pipeline-logs/

# ── Azure (Synapse Serverless SQL + ADLS Gen2) ─────────────────
# Service principal needs: Storage Blob Data Reader on ADLS, Synapse SQL Admin
#AZURE_TENANT_ID=your-tenant-id
#AZURE_CLIENT_ID=your-service-principal-client-id
#AZURE_CLIENT_SECRET=your-service-principal-secret
#AZURE_SUBSCRIPTION_ID=your-subscription-id
#AZURE_STORAGE_ACCOUNT=yourstorageaccount
#AZURE_ADLS_CONTAINER=your-container
#AZURE_SYNAPSE_WORKSPACE=your-synapse-workspace
#AZURE_SYNAPSE_SQL_ENDPOINT=your-workspace.sql.azuresynapse.net

# ── Alerting (Slack webhook for alert notifications) ──────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
SLACK_CHANNEL=#alerts-prod

# ── PagerDuty (for critical alerts) ──────────────────────────
PAGERDUTY_SERVICE_KEY=your_pagerduty_key

# ── Service config ─────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=production
